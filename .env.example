# PointsYeah MCP Middleware Server Environment Configuration Example

# -----------------------------------------------------------------------------
# 1. PointsYeah Upstream API Settings
# -----------------------------------------------------------------------------
# Base URL for PointsYeah Public API (default: https://ai-api.pointsyeah.com)
POINTSYEAH_BASE_URL=https://ai-api.pointsyeah.com

# Default PointsYeah API key for the server owner.
# If an MCP client doesn't provide their own key, this key will be used.
# If someone else uses this server with their own key, their key takes precedence.
DEFAULT_POINTSYEAH_API_KEY=your_pointsyeah_api_key_here

# -----------------------------------------------------------------------------
# 2. Server Access Control & Security
# -----------------------------------------------------------------------------
# Authorized tokens allowed to connect to this MCP server.
#
# Option A: Single token
# SERVER_API_KEY=super-secret-mcp-access-token-12345
#
# Option B: Multi-user tokens (with user labels for tracking/attribution)
SERVER_API_KEYS=owner:token_owner_secret_123,alice:token_alice_secret_456,bob:token_bob_secret_789

# -----------------------------------------------------------------------------
# 3. Rate Limiting & Abuse Prevention
# -----------------------------------------------------------------------------
# Maximum requests per minute per IP / token
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# -----------------------------------------------------------------------------
# 4. Networking & Web Best Practices
# -----------------------------------------------------------------------------
PORT=8080
HOST=0.0.0.0
DEBUG=false

# Allowed CORS Origins (comma-separated or * for all)
ALLOWED_ORIGINS=*
